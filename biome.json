{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!public"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "security": {
        "noDangerouslySetInnerHtml": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/projects/sonar/SonarRendering.*",
        "src/assets/*.svg"
      ],
      "linter": {
        "rules": {
          "a11y": "warn",
          "complexity": "warn",
          "correctness": "warn",
          "style": "warn",
          "suspicious": "warn"
        }
      }
    }
  ]
}
